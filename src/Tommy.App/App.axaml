<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tommy.App.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Mono">Cascadia Code,Consolas,Menlo,monospace</FontFamily>
            <ResourceDictionary.ThemeDictionaries>

                <!-- Light theme (default) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBg" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PillBg" Color="#EEF2FF" />
                    <SolidColorBrush x:Key="UserBg" Color="#E8F0FE" />
                    <SolidColorBrush x:Key="AssistantBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CodeBg" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="Fg" Color="#1A1D22" />
                    <SolidColorBrush x:Key="Muted" Color="#6B7280" />
                    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
                    <SolidColorBrush x:Key="BorderCol" Color="#E3E6EA" />
                </ResourceDictionary>

                <!-- Dark theme -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBg" Color="#0F1115" />
                    <SolidColorBrush x:Key="PanelBg" Color="#171A21" />
                    <SolidColorBrush x:Key="PillBg" Color="#101722" />
                    <SolidColorBrush x:Key="UserBg" Color="#1E2A3A" />
                    <SolidColorBrush x:Key="AssistantBg" Color="#171A21" />
                    <SolidColorBrush x:Key="CodeBg" Color="#0B0D11" />
                    <SolidColorBrush x:Key="Fg" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="Muted" Color="#8A93A2" />
                    <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
                    <SolidColorBrush x:Key="BorderCol" Color="#232833" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
