<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tommy.App.ViewModels"
        x:Class="Tommy.App.Views.McpConfigWindow"
        x:DataType="vm:McpConfigViewModel"
        Title="Connect MCP" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                   Foreground="{DynamicResource Fg}" />

        <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:McpFieldInput">
                    <Grid ColumnDefinitions="140,*" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg}" />
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}"
                                 IsVisible="{Binding !Secret}" />
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}"
                                 IsVisible="{Binding Secret}" PasswordChar="&#x2022;" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox Content="Read-only (block writes)" IsChecked="{Binding ReadOnly, Mode=TwoWay}" />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="14,5" Click="OnCancel" />
            <Button Content="Connect" Padding="14,5" Click="OnConnect"
                    Background="{DynamicResource Accent}" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
