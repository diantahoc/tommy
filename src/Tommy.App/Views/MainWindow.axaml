<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tommy.App.ViewModels"
        xmlns:rnd="using:Tommy.App.Rendering"
        xmlns:ctl="using:Tommy.App.Controls"
        xmlns:conv="using:Tommy.App.Converters"
        x:Class="Tommy.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Tommy" Width="1040" Height="720"
        Background="{DynamicResource AppBg}">

    <Window.Resources>
        <conv:HeadingFontSizeConverter x:Key="HeadingSize" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.section">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style Selector="Button.section.active">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.activity">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.iconbtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCol}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- Message bubble: user from the right, assistant from the left, no role titles -->
        <DataTemplate DataType="vm:ChatMessageViewModel">
            <Border Margin="0,6" Padding="12,10" CornerRadius="12"
                    Classes.user="{Binding IsUser}" Classes.assistant="{Binding !IsUser}"
                    BorderBrush="{DynamicResource BorderCol}" BorderThickness="1">
                <Border.Styles>
                    <Style Selector="Border.user">
                        <Setter Property="Background" Value="{DynamicResource UserBg}" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="MaxWidth" Value="560" />
                    </Style>
                    <Style Selector="Border.assistant">
                        <Setter Property="Background" Value="{DynamicResource AssistantBg}" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="MaxWidth" Value="780" />
                    </Style>
                </Border.Styles>
                <StackPanel>
                    <!-- thinking bubble (collapsed by default) -->
                    <Expander IsVisible="{Binding HasReasoning}"
                              IsExpanded="{Binding IsReasoningExpanded}"
                              Margin="0,0,0,6" Padding="0">
                        <Expander.Header>
                            <TextBlock Text="Thinking" FontSize="12"
                                       Foreground="{DynamicResource Muted}" />
                        </Expander.Header>
                        <SelectableTextBlock Text="{Binding Reasoning}" TextWrapping="Wrap"
                                             FontSize="12" Foreground="{DynamicResource Muted}"
                                             FontFamily="{DynamicResource Mono}" />
                    </Expander>

                    <!-- attachments: image thumbnails / document chips -->
                    <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}"
                                  Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- rendered content blocks -->
                    <ItemsControl ItemsSource="{Binding Blocks}" />

                    <!-- per-response stats -->
                    <TextBlock Text="{Binding Stats}" IsVisible="{Binding HasStats}"
                               FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Attachment: image thumbnail or document chip -->
        <DataTemplate DataType="vm:AttachmentViewModel">
            <Border Margin="0,0,6,6" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderCol}" Background="{DynamicResource CodeBg}"
                    ToolTip.Tip="{Binding FileName}">
                <Panel>
                    <!-- image thumbnail -->
                    <Image Source="{Binding Thumbnail}" IsVisible="{Binding IsImage}"
                           MaxWidth="180" MaxHeight="140" Stretch="UniformToFill" />
                    <!-- document chip -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,6"
                                IsVisible="{Binding !IsImage}">
                        <TextBlock Text="&#x1F4C4;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>
                    <!-- remove (compose strip only) -->
                    <Button IsVisible="{Binding ShowRemove}" Command="{Binding RemoveCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                            Padding="5,0" CornerRadius="8" FontSize="11" Content="&#x2715;"
                            Background="#99000000" Foreground="White" ToolTip.Tip="Remove" />
                </Panel>
            </Border>
        </DataTemplate>

        <!-- Tool call: a light intent line with collapsible details (inside an activity) -->
        <DataTemplate DataType="vm:ToolCallViewModel">
            <StackPanel Margin="0,3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="•" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IntentLabel}" Foreground="{DynamicResource Fg}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Classes="link" IsVisible="{Binding HasDetail}" Click="OnToggleExpand"
                        Margin="16,1,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DetailHeader}" FontSize="11" Foreground="{DynamicResource Accent}" />
                </Button>
                <StackPanel IsVisible="{Binding IsDetailExpanded}" Margin="16,2,0,2">
                    <SelectableTextBlock IsVisible="{Binding HasArgs}" Text="{Binding ArgsJson}"
                                         FontFamily="{DynamicResource Mono}" FontSize="11"
                                         Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <SelectableTextBlock Text="{Binding Detail}" FontFamily="{DynamicResource Mono}" FontSize="12"
                                         Foreground="{DynamicResource Fg}" TextWrapping="Wrap" MaxHeight="300" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Thinking step (inside an activity) -->
        <DataTemplate DataType="vm:ThinkingItemViewModel">
            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"
                                 Foreground="{DynamicResource Muted}" Margin="0,2,0,6" />
        </DataTemplate>

        <!-- Activity group: one collapsible "Working on…" block per run -->
        <DataTemplate DataType="vm:ActivityViewModel">
            <StackPanel Margin="0,4">
                <Button Classes="activity" Click="OnToggleExpand" HorizontalAlignment="Left" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▸" IsVisible="{Binding !IsExpanded}" FontSize="10"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="▾" IsVisible="{Binding IsExpanded}" FontSize="10"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HeaderText}" Foreground="{DynamicResource Muted}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Border IsVisible="{Binding IsExpanded}" Margin="7,2,0,2" Padding="10,2,0,2"
                        BorderBrush="{DynamicResource BorderCol}" BorderThickness="1,0,0,0">
                    <ItemsControl ItemsSource="{Binding Items}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Block: paragraph -->
        <DataTemplate DataType="rnd:MdParagraph">
            <SelectableTextBlock rnd:MarkdownInline.Text="{Binding Markdown}"
                                 TextWrapping="Wrap" Margin="0,3"
                                 Foreground="{DynamicResource Fg}" />
        </DataTemplate>

        <!-- Block: heading -->
        <DataTemplate DataType="rnd:MdHeading">
            <SelectableTextBlock rnd:MarkdownInline.Text="{Binding Markdown}"
                                 TextWrapping="Wrap" Margin="0,6,0,2" FontWeight="Bold"
                                 Foreground="{DynamicResource Fg}"
                                 FontSize="{Binding Level, Converter={StaticResource HeadingSize}}" />
        </DataTemplate>

        <!-- Block: fenced code -->
        <DataTemplate DataType="rnd:MdCode">
            <Border Background="{DynamicResource CodeBg}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderCol}" BorderThickness="1" Margin="0,4" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,6,6,0">
                        <TextBlock Grid.Column="0" Text="{Binding Language}"
                                   FontSize="11" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Copy" FontSize="11" Padding="8,2"
                                Click="OnCopyCode" Background="Transparent"
                                Foreground="{DynamicResource Accent}" />
                    </Grid>
                    <SelectableTextBlock Grid.Row="1" Text="{Binding Code}" TextWrapping="Wrap"
                                         FontFamily="{DynamicResource Mono}" FontSize="13"
                                         Foreground="{DynamicResource Fg}" Margin="10,4,10,10" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Block: quote -->
        <DataTemplate DataType="rnd:MdQuote">
            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                    Margin="0,4" Padding="10,2">
                <SelectableTextBlock rnd:MarkdownInline.Text="{Binding Markdown}"
                                     TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
            </Border>
        </DataTemplate>

        <!-- Block: list -->
        <DataTemplate DataType="rnd:MdList">
            <ItemsControl ItemsSource="{Binding Items}" Margin="6,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="•  " Foreground="{DynamicResource Muted}" />
                            <SelectableTextBlock Grid.Column="1" rnd:MarkdownInline.Text="{Binding}"
                                                 TextWrapping="Wrap" Foreground="{DynamicResource Fg}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Block: thematic break -->
        <DataTemplate DataType="rnd:MdRule">
            <Border Height="1" Background="{DynamicResource BorderCol}" Margin="0,8" />
        </DataTemplate>

        <!-- Block: pipe table -->
        <DataTemplate DataType="rnd:MdTable">
            <Border Margin="0,6" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left"
                    BorderBrush="{DynamicResource BorderCol}" BorderThickness="1"
                    rnd:MarkdownTableView.Source="{Binding}" />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- Sidebar: icon bar, search, new + sort/group, chat list -->
        <Border Grid.Column="0" Width="{Binding SidebarWidthPx}" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderCol}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="8">

                <!-- icon bar: menu · collapse  ···  chats · code -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,8">
                    <Button Grid.Column="0" Classes="iconbtn" ToolTip.Tip="Menu">
                        <TextBlock Text="&#x2630;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Settings…" Click="OnOpenSettings" />
                                <Separator />
                                <MenuItem Header="Toggle light/dark theme" Click="OnToggleTheme" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="1" Classes="iconbtn" Margin="6,0,0,0"
                            Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Collapse / expand sidebar">
                        <TextBlock Text="&#x2B0C;" FontSize="13" />
                    </Button>
                    <Button Grid.Column="3" Classes="section" IsVisible="{Binding SidebarExpanded}"
                            Classes.active="{Binding IsChatsSection}" Command="{Binding SetSectionChatsCommand}"
                            Padding="8,4" ToolTip.Tip="Chats">
                        <TextBlock Text="&#x1F4AC;" FontSize="13" />
                    </Button>
                    <Button Grid.Column="4" Classes="section" Margin="6,0,0,0" IsVisible="{Binding SidebarExpanded}"
                            Classes.active="{Binding IsCodeSection}" Command="{Binding SetSectionCodeCommand}"
                            Padding="8,4" ToolTip.Tip="Code">
                        <TextBlock Text="&lt;/&gt;" FontSize="12" />
                    </Button>
                </Grid>

                <TextBox Grid.Row="1" Watermark="Search…" Margin="0,0,0,6" IsVisible="{Binding SidebarExpanded}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,6" IsVisible="{Binding SidebarExpanded}">
                    <Button Grid.Column="0" Content="+ New" Click="OnNewClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="New chat (or code chat in the Code tab)" />
                    <Button Grid.Column="1" Classes="iconbtn" Margin="6,0,0,0" ToolTip.Tip="Sort &amp; group">
                        <TextBlock Text="&#x21C5;" FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Sort by name" ToggleType="Radio"
                                          IsChecked="{Binding IsSortName, Mode=OneWay}"
                                          Command="{Binding SortByNameCommand}" />
                                <MenuItem Header="Sort by last updated" ToggleType="Radio"
                                          IsChecked="{Binding IsSortUpdated, Mode=OneWay}"
                                          Command="{Binding SortByUpdatedCommand}" />
                                <MenuItem Header="Sort by date created" ToggleType="Radio"
                                          IsChecked="{Binding IsSortCreated, Mode=OneWay}"
                                          Command="{Binding SortByCreatedCommand}" />
                                <Separator />
                                <MenuItem Header="Descending" ToggleType="CheckBox"
                                          IsChecked="{Binding SortDescending, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="No grouping" ToggleType="Radio"
                                          IsChecked="{Binding IsGroupNone, Mode=OneWay}"
                                          Command="{Binding GroupByNoneCommand}" />
                                <MenuItem Header="Group by project" ToggleType="Radio"
                                          IsChecked="{Binding IsGroupProject, Mode=OneWay}"
                                          Command="{Binding GroupByProjectCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <ListBox Grid.Row="3" x:Name="ChatListBox" ItemsSource="{Binding ChatList}"
                         IsVisible="{Binding SidebarExpanded}"
                         SelectionChanged="OnChatSelected" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatListItem">
                            <Panel Background="Transparent">
                                <!-- group header -->
                                <TextBlock Text="{Binding Title}" IsVisible="{Binding IsHeader}"
                                           FontSize="11" FontWeight="SemiBold" Margin="2,8,0,2"
                                           Foreground="{DynamicResource Muted}" />
                                <!-- chat row -->
                                <StackPanel Margin="2,3" IsVisible="{Binding !IsHeader}">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Muted}"
                                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Panel.ContextMenu>
                                    <ContextMenu Opened="OnChatContextOpened">
                                        <MenuItem Header="Open in Explorer" Click="OnOpenInExplorer" />
                                        <MenuItem Header="Pin" Click="OnPinChat" />
                                        <MenuItem Header="Rename" Click="OnRenameChat" />
                                        <MenuItem Header="Fork" Click="OnForkChat" />
                                        <MenuItem Header="Assign to Project" />
                                        <MenuItem Header="Archive" Click="OnArchiveChat" />
                                        <MenuItem Header="Delete" Click="OnDeleteChat" />
                                    </ContextMenu>
                                </Panel.ContextMenu>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main: top bar + active chat -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Top bar: engine state (shell), autonomy + working dir (active chat) -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBg}" Padding="14,10"
                    BorderBrush="{DynamicResource BorderCol}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Tommy" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Fg}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Start" FontSize="12" Padding="10,3" VerticalAlignment="Center"
                                IsVisible="{Binding CanManageEngine}" Command="{Binding StartEngineCommand}"
                                Background="Transparent" Foreground="{DynamicResource Accent}" />
                        <Button Content="Stop" FontSize="12" Padding="10,3" VerticalAlignment="Center"
                                IsVisible="{Binding CanManageEngine}" Command="{Binding StopEngineCommand}"
                                Background="Transparent" Foreground="{DynamicResource Muted}" />
                        <Button Classes="link" VerticalAlignment="Center" ToolTip.Tip="Engine telemetry &amp; cost">
                            <Border CornerRadius="10" Padding="10,4" Background="{DynamicResource PillBg}">
                                <TextBlock Foreground="{DynamicResource Accent}" FontSize="12">
                                    <Run Text="engine:" Foreground="{DynamicResource Muted}" />
                                    <Run Text="{Binding StatusLine}" />
                                </TextBlock>
                            </Border>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="260" Spacing="6">
                                        <TextBlock Text="Engine telemetry" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg}" />
                                        <TextBlock Text="{Binding Telemetry.GpuName}" FontSize="11"
                                                   Foreground="{DynamicResource Muted}"
                                                   IsVisible="{Binding Telemetry.GpuName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="engine unreachable" FontSize="12"
                                                   Foreground="{DynamicResource Muted}"
                                                   IsVisible="{Binding !Telemetry.HasData}" />

                                        <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                              IsVisible="{Binding Telemetry.HasData}">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="State"
                                                       Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Telemetry.State}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU"
                                                       Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Telemetry.Gpu}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="VRAM"
                                                       Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Telemetry.Vram}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU"
                                                       Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Telemetry.Cpu}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="RAM"
                                                       Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Telemetry.Ram}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Vision"
                                                       Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Telemetry.Vision}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderCol}" />
                                        <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Energy"
                                                       Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding ActiveChat.EnergyLabel}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cost"
                                                       Foreground="{DynamicResource Muted}" FontSize="12"
                                                       IsVisible="{Binding ActiveChat.HasCost}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding ActiveChat.CostLabel}"
                                                       Foreground="{DynamicResource Fg}" FontSize="12"
                                                       IsVisible="{Binding ActiveChat.HasCost}" />
                                        </Grid>
                                        <TextBlock Text="cost is a GPU-power estimate" FontSize="10"
                                                   Foreground="{DynamicResource Muted}"
                                                   IsVisible="{Binding ActiveChat.HasCost}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="&#x2630;" FontSize="14" Padding="8,2" VerticalAlignment="Center"
                                ToolTip.Tip="Context details"
                                Background="Transparent" Foreground="{DynamicResource Muted}"
                                Command="{Binding ToggleRightSidebarCommand}" />
                        <Button Content="◐" FontSize="14" Padding="8,2" ToolTip.Tip="Toggle light/dark theme"
                                Background="Transparent" Foreground="{DynamicResource Muted}"
                                Click="OnToggleTheme" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active chat (or an empty state when nothing is selected) -->
            <Panel Grid.Row="1">

                <!-- empty state: no chat selected -->
                <StackPanel IsVisible="{Binding ActiveChat, Converter={x:Static ObjectConverters.IsNull}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="No chat selected" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Pick a chat on the left, or start a new one." FontSize="12"
                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Docked layout: input pinned to the bottom, approval above it,
                     transcript fills the rest — so nothing can overlap the input. -->
                <Grid IsVisible="{Binding ActiveChat, Converter={x:Static ObjectConverters.IsNotNull}}"
                      RowDefinitions="*,Auto">

                    <!-- Transcript (fills the remaining space) with jump-to-latest overlay -->
                    <Grid
                        Grid.Row="0"
                        DataContext="{Binding ActiveChat}" x:DataType="vm:ChatViewModel">
                        <ScrollViewer x:Name="ChatScroll" 
                                      Margin="16"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Messages}" />
                                <!-- activity hint: what the chat is waiting on, under the last message -->
                                <TextBlock Text="{Binding ActivityHint}" IsVisible="{Binding HasActivityHint}"
                                           HorizontalAlignment="Left" Margin="4,6,0,0" FontSize="12"
                                           FontStyle="Italic" Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="JumpButton" Content="↓ Jump to latest"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,12" Padding="12,6" CornerRadius="14"
                                IsVisible="False"
                                Background="{DynamicResource Accent}" Foreground="White"
                                Click="OnJumpToLatest" />
                    </Grid>
                    
                    <!-- Input + below-input control/status bar (very bottom) -->
                    <Border
                        Grid.Row="1"
                        DataContext="{Binding ActiveChat}" x:DataType="vm:ChatViewModel"
                        Background="{DynamicResource PanelBg}" Padding="12,10"
                        BorderBrush="{DynamicResource BorderCol}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">
                            <!-- staged attachments (thumbnails / chips with remove) -->
                            <ItemsControl ItemsSource="{Binding PendingAttachments}"
                                          IsVisible="{Binding HasPendingAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- message box -->
                            <TextBox x:Name="InputBox"
                                     Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Message Tommy…  (Enter to send, Shift+Enter for newline)"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                                     VerticalContentAlignment="Center" />

                            <!-- controls: attach · autonomy · effort  ·····  send -->
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Button Grid.Column="0" Classes="iconbtn" ToolTip.Tip="Add">
                                    <TextBlock Text="+" FontSize="18" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Add file" Click="OnAttachFiles" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" MinWidth="140" FontSize="12"
                                          ItemsSource="{Binding AutonomyOptions}"
                                          SelectedItem="{Binding Autonomy, Mode=TwoWay}"
                                          ToolTip.Tip="Autonomy level (permission)" />
                                <ComboBox Grid.Column="2" Margin="6,0,0,0" MinWidth="110" FontSize="12"
                                          ItemsSource="{Binding ThinkingEffortOptions}"
                                          SelectedItem="{Binding ThinkingEffort, Mode=TwoWay}"
                                          ToolTip.Tip="Reasoning effort" />
                                <Panel Grid.Column="4">
                                    <Button Content="Send" Padding="18,6"
                                            IsVisible="{Binding !IsSending}"
                                            Command="{Binding SendCommand}"
                                            Background="{DynamicResource Accent}" Foreground="White" />
                                    <Button Content="Stop" Padding="18,6"
                                            IsVisible="{Binding IsSending}"
                                            Command="{Binding StopCommand}"
                                            ToolTip.Tip="Stop the current run"
                                            Background="{DynamicResource Danger}" Foreground="White" />
                                </Panel>
                            </Grid>

                            <!-- status line: workspace · branch  ·····  context ring -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center" IsVisible="{Binding IsCodeChat}">
                                    <TextBlock Text="{Binding WorkspaceLabel}" FontSize="11"
                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource Muted}"
                                               IsVisible="{Binding HasGitBranch}" />
                                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasGitBranch}">
                                        <TextBlock Text="⎇" FontSize="11" Foreground="{DynamicResource Muted}" />
                                        <TextBlock Text="{Binding GitBranch}" FontSize="11"
                                                   Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" ToolTip.Tip="{Binding ContextLabel}">
                                    <ctl:RingProgress Width="18" Height="18" StrokeThickness="2.5"
                                                      Percentage="{Binding ContextPercent}"
                                                      Foreground="{DynamicResource Accent}"
                                                      TrackBrush="{DynamicResource BorderCol}" />
                                    <TextBlock Text="{Binding ContextPercentLabel}" FontSize="11"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Approval prompt (gated tool calls) — docked just above the input -->
                    <Border
                        Grid.Row="0"
                        VerticalAlignment="Bottom"
                        DataContext="{Binding ActiveChat}" x:DataType="vm:ChatViewModel"
                        Margin="12,8,12,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource PillBg}"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                        IsVisible="{Binding PendingApproval, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock Foreground="{DynamicResource Fg}" FontWeight="SemiBold">
                                <Run Text="Approve" />
                                <Run Text="{Binding PendingApproval.ToolName}" />
                                <Run Text="  " />
                                <Run Text="{Binding PendingApproval.TierLabel}" Foreground="{DynamicResource Muted}" />
                            </TextBlock>
                            <TextBlock Text="{Binding PendingApproval.Summary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}" />
                            <!-- Details can be long (e.g. a whole file in create_file args);
                                 bound their height and scroll, so the buttons stay on screen. -->
                            <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <SelectableTextBlock Text="{Binding PendingApproval.ArgsJson}" TextWrapping="Wrap"
                                                         FontFamily="{DynamicResource Mono}" FontSize="12"
                                                         Foreground="{DynamicResource Fg}" />
                                    <SelectableTextBlock IsVisible="{Binding PendingApproval.HasDiff}"
                                                         Text="{Binding PendingApproval.Diff}" TextWrapping="Wrap"
                                                         FontFamily="{DynamicResource Mono}" FontSize="12"
                                                         Foreground="{DynamicResource Fg}" />
                                </StackPanel>
                            </ScrollViewer>
                            <TextBox Text="{Binding PendingApproval.DenyReason, Mode=TwoWay}"
                                     Watermark="Reason for denial (optional) — tells the model why and to stop"
                                     AcceptsReturn="False" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Deny &amp; stop" Padding="14,5" Command="{Binding PendingApproval.DenyCommand}"
                                        Background="{DynamicResource Danger}" Foreground="White" />
                                <Button Content="Allow" Padding="14,5" Command="{Binding PendingApproval.AllowCommand}"
                                        Background="{DynamicResource Accent}" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Question prompt (ask_question tool) — docked just above the input -->
                    <Border
                        Grid.Row="0"
                        VerticalAlignment="Bottom"
                        DataContext="{Binding ActiveChat}" x:DataType="vm:ChatViewModel"
                        Margin="12,8,12,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource PillBg}"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                        IsVisible="{Binding PendingQuestion, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding PendingQuestion.Question}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <ItemsControl ItemsSource="{Binding PendingQuestion.Options}"
                                          IsVisible="{Binding PendingQuestion.HasOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuestionOption">
                                        <Button Content="{Binding Text}" Margin="0,0,6,6" Padding="12,5"
                                                Command="{Binding ChooseCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding PendingQuestion.AllowCustom}">
                                <TextBox Grid.Column="0" Text="{Binding PendingQuestion.CustomAnswer, Mode=TwoWay}"
                                         Watermark="Type your own answer…" AcceptsReturn="False" FontSize="12" />
                                <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Padding="14,5"
                                        Command="{Binding PendingQuestion.SubmitCustomCommand}"
                                        Background="{DynamicResource Accent}" Foreground="White" />
                            </Grid>
                            <Button Content="Dismiss" Padding="10,4" HorizontalAlignment="Right"
                                    Classes="link" Command="{Binding PendingQuestion.DismissCommand}" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Panel>
        </Grid>

        <!-- Right sidebar: context-window breakdown (toggle from the top bar) -->
        <Border Grid.Column="2" Width="{Binding RightSidebarWidthPx}" IsVisible="{Binding RightSidebarOpen}"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderCol}" BorderThickness="1,0,0,0">
            <Panel>
                <!-- no chat selected -->
                <TextBlock Text="No chat selected" FontSize="12" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding ActiveChat, Converter={x:Static ObjectConverters.IsNull}}" />

                <ScrollViewer IsVisible="{Binding ActiveChat, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Margin="14,14" Spacing="14" x:DataType="vm:ShellViewModel">

                        <!-- Per-chat: context breakdown + enabled tools -->
                        <StackPanel Spacing="10" DataContext="{Binding ActiveChat}" x:DataType="vm:ChatViewModel">
                            <TextBlock Text="Context" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource Fg}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Fg}">
                                    <Run Text="{Binding ContextPercentLabel}" FontWeight="SemiBold" />
                                    <Run Text="used" Foreground="{DynamicResource Muted}" />
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding ContextLabel}" FontSize="12"
                                           Foreground="{DynamicResource Muted}" />
                            </Grid>

                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ContextPercent}"
                                         Height="6" Foreground="{DynamicResource Accent}" />

                            <ItemsControl ItemsSource="{Binding ContextSlices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ContextSlice">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                            <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2"
                                                    Background="{Binding Brush}" VerticalAlignment="Center"
                                                    Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                                                       Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding TokensLabel}" FontSize="12"
                                                           Foreground="{DynamicResource Muted}" />
                                                <TextBlock Text="{Binding PercentLabel}" FontSize="12" MinWidth="44"
                                                           TextAlignment="Right" Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="estimated (≈ chars ÷ 4)" FontSize="10"
                                       Foreground="{DynamicResource Muted}" />

                            <Border Height="1" Background="{DynamicResource BorderCol}" Margin="0,4" />

                            <TextBlock Text="Tools" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource Fg}" />
                            <TextBlock Text="Turn tools on or off for this chat." FontSize="11"
                                       Foreground="{DynamicResource Muted}" />
                            <ItemsControl ItemsSource="{Binding ToolGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ToolGroupViewModel">
                                        <StackPanel Margin="0,1">
                                            <!-- group header: caret · name · count · master switch -->
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                <Button Grid.Column="0" Classes="iconbtn" Padding="2,0"
                                                        Command="{Binding ToggleExpandCommand}"
                                                        VerticalAlignment="Center">
                                                    <Panel Width="10">
                                                        <TextBlock Text="&#x25B8;" FontSize="10"
                                                                   IsVisible="{Binding !IsExpanded}" />
                                                        <TextBlock Text="&#x25BE;" FontSize="10"
                                                                   IsVisible="{Binding IsExpanded}" />
                                                    </Panel>
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="10"
                                                           Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="3" MinWidth="0" OnContent="" OffContent=""
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding AllEnabled, Mode=TwoWay}" />
                                            </Grid>
                                            <!-- group members -->
                                            <ItemsControl ItemsSource="{Binding Tools}"
                                                          IsVisible="{Binding IsExpanded}"
                                                          Margin="20,2,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ToolToggleViewModel">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource Fg}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent=""
                                                                          OffContent=""
                                                                          IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderCol}" />

                        <!-- MCP servers connected to this chat, with an add (+) picker -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Connected MCPs" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="iconbtn" ToolTip.Tip="Connect an MCP server to this chat">
                                <TextBlock Text="+" FontSize="16" />
                                <Button.Flyout>
                                    <Flyout>
                                        <ScrollViewer MaxHeight="320" MinWidth="200">
                                            <StackPanel>
                                                <TextBlock Text="Connect a server" FontSize="11" FontWeight="SemiBold"
                                                           Margin="4,2,4,6" Foreground="{DynamicResource Muted}" />
                                                <ItemsControl ItemsSource="{Binding McpCatalog}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:McpCatalogEntry">
                                                            <Button Click="OnPickMcp" HorizontalAlignment="Stretch"
                                                                    Padding="8,5"
                                                                    Background="Transparent"
                                                                    HorizontalContentAlignment="Left">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="12" />
                                                                    <TextBlock Text="needs configuration" FontSize="10"
                                                                               Foreground="{DynamicResource Muted}"
                                                                               IsVisible="{Binding IsIntegration}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ActiveChat.ConnectedMcps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectedMcpViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                       Foreground="{DynamicResource Fg}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" FontSize="10"
                                                       Foreground="{DynamicResource Muted}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="iconbtn" Command="{Binding RemoveCommand}"
                                                ToolTip.Tip="Disconnect">
                                            <TextBlock Text="&#x2715;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>

        <!-- File pane: a file opened by the model via present_file -->
        <Border Grid.Column="3" Width="380"
                IsVisible="{Binding FilePane, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderCol}" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*" DataContext="{Binding FilePane}" x:DataType="vm:FilePaneViewModel">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,8,8">
                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg}" ToolTip.Tip="{Binding Path}" />
                    <Button Grid.Column="1" Content="✕" Classes="iconbtn" Padding="6,2"
                            ToolTip.Tip="Close file pane"
                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseFilePaneCommand}" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <Panel Margin="12,4,12,12">
                        <Image Source="{Binding Image}" IsVisible="{Binding IsImage}"
                               Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding Blocks}" IsVisible="{Binding IsText}" />
                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Danger}" />
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>