# Claude Code local session settings
.claude/settings.local.json

# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user

# IDE
.vs/
.idea/

# UI snapshot PNGs (generated by Tommy.Snapshots for visual verification)
artifacts/

# Bundled runtimes/browsers produced by build-and-copy.ps1 (fetched, not committed)
integrated-tools/browsers/
integrated-tools/runtimes/python-*/
integrated-tools/mcp/**/node_modules/


# LM Studio's proprietary AppContainer helper — can't be redistributed (their ToU).
# Place it in src/scripts/ locally; it is not committed.
src/scripts/office-document-helper.exe

# Debug symbols for the local C++ sandbox launcher (large build artifact).
src/scripts/*.pdb
